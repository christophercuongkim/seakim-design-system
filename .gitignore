# Local, machine-specific Claude Code settings (permission allowlist etc.)
.claude/settings.local.json

# Flutter build artifacts (generated by `flutter pub get` / builds)
flutter/.dart_tool/
flutter/build/
flutter/pubspec.lock
flutter/.flutter-plugins
flutter/.flutter-plugins-dependencies

# direnv
.direnv/

# Example app build artifacts
flutter/example/build/
flutter/example/.dart_tool/
flutter/example/pubspec.lock
flutter/example/*.iml

# Next.js example build artifacts
next/example/node_modules/
next/example/.next/
next/example/next-env.d.ts
next/example/tsconfig.tsbuildinfo
